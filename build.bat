@echo off
set "COB_MAIN_DIR=C:\GnuCOBOL\"
set "PATH=%COB_MAIN_DIR%bin;%PATH%"
set "COB_CONFIG_DIR=%COB_MAIN_DIR%config"
set "COB_COPY_DIR=%COB_MAIN_DIR%copy"
echo Building SHA-256 Engine...
cobc -free -x -Wall -Icopybooks src\sha256_engine.cbl -o sha256_engine.exe
echo Building SHA-256 Test...
cobc -free -x -Wall -Icopybooks tests\sha256_test.cbl src\sha256_sub.cbl src\sha256_helper.c -o sha256_test.exe
echo Building PBKDF2 Test...
cobc -free -x -Wall -Icopybooks tests\pbkdf2_test.cbl src\pbkdf2_engine.cbl -o pbkdf2_test.exe
echo Building HMAC Test...
cobc -free -x -Wall -Icopybooks tests\sha256_hmac_test.cbl src\sha256_hmac.cbl -o sha256_hmac_test.exe
echo Building HKDF Test...
cobc -free -x -Wall -Icopybooks tests\sha256_hkdf_test.cbl src\sha256_hkdf.cbl -o sha256_hkdf_test.exe
echo Building Stream Test...
cobc -free -x -Wall -Icopybooks tests\sha256_stream_test.cbl src\sha256_stream_io.cbl -o sha256_stream_test.exe
echo Building DRBG Test...
cobc -free -x -Wall -Icopybooks tests\sha256_drbg_test.cbl src\sha256_drbg.cbl -o sha256_drbg_test.exe
echo Building Constant Time Test...
cobc -free -x -Wall -Icopybooks tests\sha256_ct_test.cbl src\sha256_constant_time.cbl -o sha256_ct_test.exe
echo Building TOTP Test...
cobc -free -x -Wall -Icopybooks tests\sha256_totp_test.cbl src\sha256_totp.cbl -o sha256_totp_test.exe
echo Building Key Vault Test...
cobc -free -x -Wall -Icopybooks tests\sha256_keystore_test.cbl src\sha256_keystore.cbl -o sha256_keystore_test.exe
